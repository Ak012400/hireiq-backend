# Postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=hireiq;Username=postgres;Password=postgres

# JWT
JwtSettings__SecretKey=replace_with_a_long_random_string_min_32_chars
JwtSettings__Issuer=HireIQ
JwtSettings__Audience=HireIQ.Client
JwtSettings__AccessTokenHours=24

# Redis
Redis__ConnectionString=localhost:6379
Redis__InstanceName=hireiq:
Redis__DefaultTtlSeconds=300

# Azure Blob (leave empty in dev; service is only registered if set)
AzureBlob__ConnectionString=
AzureBlob__DefaultContainer=hireiq

# CORS (semicolon-separated)
Cors__AllowedOrigins=http://localhost:3000;https://hireiq.vercel.app

# AI providers
GroqSettings__ApiKey=
HFSettings__Token=
HireIQSettings__BaseUrl=
FlaskService__BaseUrl=http://127.0.0.1:5000

# Email (Brevo / Sendgrid / SES SMTP)
EmailSettings__Host=
EmailSettings__Port=587
EmailSettings__Username=
EmailSettings__Password=
EmailSettings__FromEmail=
EmailSettings__FromName=HireIQ Recruiting
